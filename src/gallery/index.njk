---
layout: base.njk
documentTitle: "Gallery — DJ Pardis"
description: Posters, flyers, and art from DJ Pardis shows and events.
bodyClass: page-gallery
---
<header class="page-header section section--page-top">
  <div class="container">
    {% set headEyebrow = "Gallery" %}
    {% include "page-head.njk" %}
    <h1 class="page-title"><span class="hl">Posters</span> and art.</h1>
    <p class="page-subtitle">Flyers · Posters · Show art</p>
  </div>
</header>

<section class="page-body section section--pad-lg">
  <div class="container">
    {% if gallery and gallery.length %}
      {% if gallery.length == 1 %}
        {% set g = gallery[0] %}
        <div class="feature-grid">
          <figure class="feature-grid__media">
            <img src="{{ g.src }}" alt="{{ g.alt }}" loading="lazy" decoding="async" />
          </figure>
          <div class="feature-grid__copy page-copy">
            <span class="feature-grid__label">// Poster</span>
            <h2 class="feature-grid__title">Bay to Breakers 2019</h2>
            <p>Sunday May 19th, 8am start. Music by DJ Pardis &amp; Pupusa Papi. A full morning of bottle-fueled dance pop and hip hop through the streets of San Francisco.</p>
            <dl class="feature-grid__meta">
              <div><dt>Designer</dt><dd>Regy Augustin</dd></div>
              <div><dt>Date</dt><dd>May 19, 2019</dd></div>
              <div><dt>City</dt><dd>San Francisco, CA</dd></div>
            </dl>
          </div>
        </div>
      {% else %}
        <ul class="gallery-grid">
          {% for g in gallery %}
            <li class="gallery-item">
              <figure>
                <img src="{{ g.src }}" alt="{{ g.alt }}" loading="lazy" decoding="async" />
                {% if g.caption %}<figcaption>{{ g.caption }}</figcaption>{% endif %}
              </figure>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    {% endif %}
  </div>
</section>
