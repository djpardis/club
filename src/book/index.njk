---
layout: base.njk
documentTitle: "Dates and details."
description: We respond within 48 hours.
bodyClass: page-booking
noIndex: true
---
<article class="booking-page">
  <header class="booking-page__header section">
    <div class="container">
      {% set headEyebrow = "Bookings" %}
      {% set headBackHref = "/" %}
      {% set headBackLabel = "Home" %}
      {% include "page-head.njk" %}
      <h1 class="page-title"><span class="hl">Dates</span> and details.</h1>
      <p class="booking-page__subtitle lead">We respond within 48 hours.</p>
    </div>
  </header>

  <section class="booking-page__body section">
    <div class="booking-page__body-inner container">
      <form
        class="booking-form"
        action="{{ site.forms.booking.action }}"
        method="POST"
        data-booking-form
        data-success-url="/book/thanks/"
      >
      <input type="text" name="website" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <fieldset class="fieldset">
        <legend class="fieldset__legend">// <span class="fieldset__num">01</span> Contact</legend>
        <div class="field-row">
          <div class="field">
            <label for="full-name">Full name</label>
            <input type="text" id="full-name" name="full_name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
        </div>
      </fieldset>

      <fieldset class="fieldset">
        <legend class="fieldset__legend">// <span class="fieldset__num">02</span> Event</legend>
        <div class="field-row">
          <div class="field">
            <label for="event-date">Event date</label>
            <input type="date" id="event-date" name="event_date" required data-event-date />
          </div>
          <div class="field">
            <label for="event-location">Event location</label>
            <input type="text" id="event-location" name="event_location" required placeholder="City, neighborhood, or venue name" />
          </div>
        </div>
        <div class="field">
          <label for="event-website">Event website <span class="field__optional">(optional)</span></label>
          <input type="url" id="event-website" name="event_website" placeholder="https://" inputmode="url" />
        </div>
      </fieldset>

      <fieldset class="fieldset">
        <legend class="fieldset__legend">// <span class="fieldset__num">03</span> Details</legend>
        <div class="field">
          <label for="comments">Comments <span class="field__optional">(optional)</span></label>
          <textarea id="comments" name="comments" rows="4" placeholder="Any details you'd like to share about your event, like the venue, crowd, or vibe."></textarea>
        </div>
      </fieldset>

        <div class="form-submit">
          <p class="form-status" data-booking-status role="status" aria-live="polite"></p>
          <button type="submit" class="btn btn--primary btn--lg">Submit <span aria-hidden="true">→</span></button>
        </div>
      </form>
      <noscript>
        <p class="form-status">After submitting, you may see a JSON confirmation from the form service.</p>
      </noscript>
    </div>
  </section>
</article>

<script>
  (function () {
    var form = document.querySelector('[data-booking-form]');
    if (!form) return;

    var status = form.querySelector('[data-booking-status]');
    var button = form.querySelector('button[type="submit"]');
    var dateInput = form.querySelector('[data-event-date]');

    function todayString() {
      var now = new Date();
      var year = now.getFullYear();
      var month = String(now.getMonth() + 1).padStart(2, '0');
      var day = String(now.getDate()).padStart(2, '0');
      return year + '-' + month + '-' + day;
    }

    function setDateBounds() {
      if (dateInput) dateInput.min = todayString();
    }

    function validateEventDate() {
      if (!dateInput) return true;

      setDateBounds();
      if (dateInput.value && dateInput.value < dateInput.min) {
        dateInput.setCustomValidity('Choose today or a future date.');
        if (status) status.textContent = 'Choose today or a future date.';
        return false;
      }

      dateInput.setCustomValidity('');
      return true;
    }

    setDateBounds();
    if (dateInput) {
      dateInput.addEventListener('input', validateEventDate);
      dateInput.addEventListener('change', validateEventDate);
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      if (!validateEventDate() || !form.reportValidity()) return;
      if (!window.fetch || !window.FormData) {
        form.submit();
        return;
      }

      if (status) status.textContent = 'Sending...';
      if (button) {
        button.disabled = true;
      }

      fetch(form.action, {
        method: 'POST',
        body: new FormData(form)
      }).then(function (response) {
        if (response.ok) return;
        return response.json().catch(function () {
          return {};
        }).then(function (body) {
          throw new Error(body.error || 'Form submission failed');
        });
      }).then(function () {
        window.location.href = form.dataset.successUrl || '/book/thanks/';
      }).catch(function (error) {
        if (status) {
          status.textContent = error instanceof TypeError
            ? 'We could not reach the form service. Please try again in a minute.'
            : error.message || 'Something went wrong. Please try again.';
        }
        if (button) {
          button.disabled = false;
        }
      });
    });
  })();
</script>
