---
layout: base.njk
documentTitle: "Book now"
description: Book DJ Pardis for company events, conferences, gallery openings, themed parties. We respond within 48 hours.
bodyClass: page-booking
noIndex: true
---
<section class="section">
  <div class="container">
    <div class="page-head">
      <p class="eyebrow">Booking inquiry</p>
      <p class="booking-back">
        <a href="/">
          <span class="booking-back__arrow" aria-hidden="true">←</span>
          <span class="booking-back__label">Home</span>
        </a>
      </p>
    </div>
    <h1 class="page-title"><span class="hl">Book us</span> for your event.</h1>
    <p class="lead">Book us to deejay your company events, conferences, gallery openings, and themed parties. We respond within 48 hours.</p>

    <form
      class="booking-form"
      action="https://formspree.io/f/{{ site.formspreeId }}"
      method="POST"
    >
      <input type="hidden" name="_next" value="{{ site.url }}/book/thanks/" />
      <input type="hidden" name="_subject" value="New booking inquiry — djpardis.club" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <fieldset class="fieldset">
        <legend class="fieldset__legend">// <span class="fieldset__num">01</span> Contact</legend>
        <div class="field-row">
          <div class="field">
            <label for="first-name">First name</label>
            <input type="text" id="first-name" name="first_name" required autocomplete="given-name" />
          </div>
          <div class="field">
            <label for="last-name">Last name</label>
            <input type="text" id="last-name" name="last_name" required autocomplete="family-name" />
          </div>
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="company">Company or venue</label>
          <input type="text" id="company" name="company" required autocomplete="organization" />
        </div>
      </fieldset>

      <fieldset class="fieldset">
        <legend class="fieldset__legend">// <span class="fieldset__num">02</span> Event</legend>
        <div class="field-row">
          <div class="field">
            <label for="event-date">Event date</label>
            <input type="date" id="event-date" name="event_date" required />
          </div>
          <div class="field">
            <label for="event-location">Event location</label>
            <input type="text" id="event-location" name="event_location" required placeholder="City, state / country" />
          </div>
        </div>
        <div class="field">
          <label for="event-website">Event website <span class="field__optional">(optional)</span></label>
          <input type="url" id="event-website" name="event_website" placeholder="https://" inputmode="url" />
        </div>
      </fieldset>

      <fieldset class="fieldset">
        <legend class="fieldset__legend">// <span class="fieldset__num">03</span> Details <span class="field__optional">(all optional)</span></legend>
        <div class="field-row">
          <div class="field">
            <label for="guest-count">Approximate guest count</label>
            <input type="number" id="guest-count" name="guest_count" min="1" inputmode="numeric" placeholder="e.g. 200" />
          </div>
          <div class="field">
            <label for="budget">Budget range</label>
            <input type="text" id="budget" name="budget" placeholder="e.g. $2–5k" />
          </div>
        </div>
        <div class="field">
          <label for="music-vibe">Music vibe or references</label>
          <textarea id="music-vibe" name="music_vibe" rows="3" placeholder="Artists, playlists, past events — anything that sets the tone."></textarea>
        </div>
        <div class="field">
          <label for="other-acts">Other acts on the bill</label>
          <input type="text" id="other-acts" name="other_acts" placeholder="DJs, bands, performers" />
        </div>
        <div class="field">
          <label for="venue-details">Venue details / setup</label>
          <textarea id="venue-details" name="venue_details" rows="3" placeholder="Indoor / outdoor, stage, sound system, load-in notes…"></textarea>
        </div>
        <div class="field">
          <label for="message">Anything else</label>
          <textarea id="message" name="message" rows="3" placeholder="Whatever didn't fit above."></textarea>
        </div>
      </fieldset>

      <div class="form-submit">
        <button type="submit" class="btn btn--primary btn--lg">Submit <span aria-hidden="true">→</span></button>
      </div>
    </form>
  </div>
</section>
