---
layout: base.njk
documentTitle: "Mixtapes"
description: DJ Pardis annual mixtapes archive.
bodyClass: page-mixtapes
---
<section class="section">
  <div class="container">
    {% set headEyebrow = "Mixtapes archive" %}
    {% set headBackHref = "/" %}
    {% set headBackLabel = "Home" %}
    {% include "page-head.njk" %}
    <h1 class="page-title"><span class="hl">All mixtapes</span>.</h1>
    <p class="lead">One mixtape every year, with track notes and links.<br /><a class="mixtapes-head__feed" href="/feed.xml">Subscribe (RSS)</a></p>

    <ul class="mixtapes-grid">
      {% for m in mixtapes | sortMixtapesDesc %}
        <li>
          <a class="mixtape-tile {% if loop.first %}mixtape-tile--latest{% endif %}" href="{{ m.url }}" rel="noopener">
            {% if loop.first %}<span class="mixtape-tile__badge">Latest</span>{% endif %}
            <span class="mixtape-tile__year">{{ m.year }}</span>
            <span class="mixtape-tile__title">{{ m.title }}</span>
            <span class="mixtape-tile__date">{{ m.date }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
