---
layout: base.njk
bodyClass: page-post
---
<article>
  <header class="mixtape-post__header section">
    <div class="container">
      {% set headEyebrow = year + " mixtape" %}
      {% set headBackHref = "/mixtapes/" %}
      {% set headBackLabel = "Mixtapes" %}
      {% include "page-head.njk" %}

      <h1 class="page-title">{{ title }}</h1>
      {% if subtitle %}
        <p class="mixtape-post__subtitle lead">{{ subtitle }}</p>
      {% endif %}
      <p class="mixtape-post__date meta">{{ displayDate }}</p>
    </div>
  </header>

  <div class="mixtape-post__body container">
    {{ content | safe }}
  </div>
</article>
