<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>
      {%- if documentTitle -%}
        {{- documentTitle -}}
      {%- elif title -%}
        {{- title }} / {{ site.name -}}
      {%- else -%}
        {{- site.name }} – Pop house · West Coast · Booking worldwide -}}
      {%- endif -%}
    </title>
    <meta name="description" content="{{ description or site.description }}" />
    <meta name="author" content="DJ Pardis" />
    <meta name="keywords" content="DJ Pardis, djpardis, DJ Pardis booking, book DJ Pardis, pop house DJ, West Coast DJ, San Francisco DJ, corporate events DJ, conference DJ, gallery opening DJ, themed party DJ, booking worldwide" />
    {% if noIndex %}
      <meta name="robots" content="noindex, nofollow, max-image-preview:large" />
    {% else %}
      <meta name="robots" content="index, follow, max-image-preview:large" />
    {% endif %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    {% if documentTitle %}
      {% set ogTitle = documentTitle %}
    {% elif title %}
      {% set ogTitle = title + ' — ' + site.name %}
    {% else %}
      {% set ogTitle = site.name + ' — ' + site.tagline %}
    {% endif %}
    {#- Homepage: use the real hero photo for og/twitter so crawlers match on-page <img>.
        Other pages: optional front-matter ogImage, else default card. -#}
    {% if ogImage %}
      {% set ogPath = ogImage %}
    {% elif page.url == "/" %}
      {% set ogPath = site.hero.photo %}
    {% else %}
      {% set ogPath = site.defaultOg.path %}
    {% endif %}
    {% set ogImage = site.url + ogPath %}
    {% if ogPath == site.hero.photo %}
      {% set ogImageW = site.hero.width %}
      {% set ogImageH = site.hero.height %}
      {% set ogImageType = site.hero.mimeType %}
      {% set ogImageAlt = site.hero.alt %}
    {% else %}
      {% set ogImageW = site.defaultOg.width %}
      {% set ogImageH = site.defaultOg.height %}
      {% set ogImageType = site.defaultOg.mimeType %}
      {% set ogImageAlt = site.defaultOg.alt %}
    {% endif %}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="{{ ogTitle }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ ogImage }}" />
    <meta property="og:image:secure_url" content="{{ ogImage }}" />
    <meta property="og:image:type" content="{{ ogImageType }}" />
    <meta property="og:image:width" content="{{ ogImageW }}" />
    <meta property="og:image:height" content="{{ ogImageH }}" />
    <meta property="og:image:alt" content="{{ ogImageAlt }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ ogTitle }}" />
    <meta name="twitter:description" content="{{ description or site.description }}" />
    <meta name="twitter:image" content="{{ ogImage }}" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/atom+xml" title="DJ Pardis — Mixtapes" href="/feed.xml" />
    <meta name="theme-color" content="#F5EDE0" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "DJ Pardis",
        "alternateName": ["djpardis", "Pardis"],
        "url": "{{ site.url }}",
        "jobTitle": "DJ",
        "description": "{{ site.description }}",
        "image": [
          "{{ site.url }}{{ site.hero.photo }}"{% for item in gallery %},
          "{{ site.url }}{{ item.src }}"{% endfor %}
        ],
        "sameAs": [
          "{{ site.socials.instagram }}",
          "{{ site.socials.soundcloud }}",
          "{{ site.socials.mixcloud }}",
          "{{ site.socials.spotify }}",
          "{{ site.socials.appleMusic }}",
          "https://djpardis.com"
        ]
      }
    </script>
    {% if page.url == "/" %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "{{ ogTitle }}",
        "url": "{{ site.url }}{{ page.url }}",
        "description": "{{ description or site.description }}",
        "primaryImageOfPage": {
          "@type": "ImageObject",
          "url": "{{ site.url }}{{ site.hero.photo }}",
          "width": {{ site.hero.width }},
          "height": {{ site.hero.height }},
          "caption": {{ site.hero.alt | jsonEncode | safe }}
        }{% if gallery and gallery.length %},
        "image": [
          {% for item in gallery %}
          {
            "@type": "ImageObject",
            "url": "{{ site.url }}{{ item.src }}",
            "caption": {{ (item.caption or item.alt) | jsonEncode | safe }}
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
        {% endif %}
      }
    </script>
    {% endif %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "{{ site.name }}",
        "alternateName": ["djpardis", "djpardis.club"],
        "url": "{{ site.url }}",
        "description": "{{ site.description }}",
        "sameAs": [
          "{{ site.socials.instagram }}",
          "{{ site.socials.soundcloud }}",
          "{{ site.socials.mixcloud }}",
          "{{ site.socials.spotify }}",
          "{{ site.socials.appleMusic }}",
          "https://djpardis.com"
        ]
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    />

    <link rel="stylesheet" href="/css/tokens.css?v=join-ink" />
    <link rel="stylesheet" href="/css/base.css?v=tablet-bottom-nav" />
    <link rel="stylesheet" href="/css/components.css?v=mobile-hero-gradient-split" />
    <script>
      // Capture the visual viewport height in pixels once so the fold fills
      // exactly one screen on desktop WKWebView in-app browsers. Only
      // re-measure on orientation change or a true width change.
      (function () {
        var lastWidth = window.innerWidth;
        function setFoldHeight() {
          var h = window.visualViewport ? window.visualViewport.height : window.innerHeight;
          document.documentElement.style.setProperty('--fold-h', h + 'px');
          lastWidth = window.innerWidth;
        }
        setFoldHeight();
        window.addEventListener('resize', function () {
          if (window.innerWidth !== lastWidth) setFoldHeight();
        });
        if (screen && screen.orientation) {
          screen.orientation.addEventListener('change', setFoldHeight);
        }
      })();
    </script>
  </head>
  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    {% include "header.njk" %}
    <main id="main" data-lightbox-group="page">
      {{ content | safe }}
    </main>
    {% include "tab-bar.njk" %}
    {% include "fold-nav.njk" %}
    <script src="/js/mixtape-gallery.js?v=card-arrows" defer></script>
    <script src="/js/lightbox.js?v=page-group" defer></script>
  </body>
</html>
