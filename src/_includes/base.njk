<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>
      {%- if documentTitle -%}
        {{- documentTitle -}}
      {%- elif title -%}
        {{- title }} / {{ site.name -}}
      {%- else -%}
        {{- site.name }} - Pop house, West Coast, booking worldwide -}}
      {%- endif -%}
    </title>
    <meta name="description" content="{{ description or site.description }}" />
    <meta name="author" content="DJ Pardis" />
    <meta name="keywords" content="DJ Pardis, djpardis, DJ Pardis booking, book DJ Pardis, pop house DJ, West Coast DJ, San Francisco DJ, corporate events DJ, conference DJ, gallery opening DJ, themed party DJ, booking worldwide" />
    {% if noIndex %}
      <meta name="robots" content="noindex, nofollow, max-image-preview:large" />
    {% else %}
      <meta name="robots" content="index, follow, max-image-preview:large" />
    {% endif %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    {% if documentTitle %}
      {% set ogTitle = documentTitle %}
    {% elif title %}
      {% set ogTitle = title + ' - ' + site.name %}
    {% else %}
      {% set ogTitle = site.name + ' - ' + site.tagline %}
    {% endif %}
    {% if ogImage %}
      {% set ogPath = ogImage %}
    {% elif page.url == "/" %}
      {% set ogPath = site.hero.photo %}
    {% else %}
      {% set ogPath = site.defaultOg.path %}
    {% endif %}
    {% set ogImage = site.url + ogPath %}
    {% if ogPath == site.hero.photo %}
      {% set ogImageW = site.hero.width %}
      {% set ogImageH = site.hero.height %}
      {% set ogImageType = site.hero.mimeType %}
      {% set ogImageAlt = site.hero.alt %}
    {% else %}
      {% set ogImageW = site.defaultOg.width %}
      {% set ogImageH = site.defaultOg.height %}
      {% set ogImageType = site.defaultOg.mimeType %}
      {% set ogImageAlt = site.defaultOg.alt %}
    {% endif %}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="{{ ogTitle }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ ogImage }}" />
    <meta property="og:image:secure_url" content="{{ ogImage }}" />
    <meta property="og:image:type" content="{{ ogImageType }}" />
    <meta property="og:image:width" content="{{ ogImageW }}" />
    <meta property="og:image:height" content="{{ ogImageH }}" />
    <meta property="og:image:alt" content="{{ ogImageAlt }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ ogTitle }}" />
    <meta name="twitter:description" content="{{ description or site.description }}" />
    <meta name="twitter:image" content="{{ ogImage }}" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/atom+xml" title="DJ Pardis - Mixtapes" href="/feed.xml" />
    <meta name="theme-color" content="#fff" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "DJ Pardis",
        "alternateName": ["DJ Pardis", "Pardis"],
        "url": "{{ site.url }}",
        "jobTitle": "DJ",
        "description": "{{ site.description }}",
        "image": [
          "{{ site.url }}{{ site.hero.photo }}"{% for item in gallery %},
          "{{ site.url }}{{ item.src }}"{% endfor %}
        ],
        "sameAs": [
          "{{ site.socials.instagram }}",
          "{{ site.socials.soundcloud }}",
          "{{ site.socials.mixcloud }}",
          "{{ site.socials.spotify }}",
          "{{ site.socials.appleMusic }}",
          "https://djpardis.com"
        ]
      }
    </script>
    {% if page.url == "/" %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "{{ ogTitle }}",
        "url": "{{ site.url }}{{ page.url }}",
        "description": "{{ description or site.description }}",
        "primaryImageOfPage": {
          "@type": "ImageObject",
          "url": "{{ site.url }}{{ site.hero.photo }}",
          "width": {{ site.hero.width }},
          "height": {{ site.hero.height }},
          "caption": {{ site.hero.alt | jsonEncode | safe }}
        }{% if gallery and gallery.length %},
        "image": [
          {% for item in gallery %}
          {
            "@type": "ImageObject",
            "url": "{{ site.url }}{{ item.src }}",
            "caption": {{ (item.caption or item.alt) | jsonEncode | safe }}
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
        {% endif %}
      }
    </script>
    {% endif %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "{{ site.name }}",
        "alternateName": ["DJ Pardis", "Pardis"],
        "url": "{{ site.url }}",
        "description": "{{ site.description }}",
        "sameAs": [
          "{{ site.socials.instagram }}",
          "{{ site.socials.soundcloud }}",
          "{{ site.socials.mixcloud }}",
          "{{ site.socials.spotify }}",
          "{{ site.socials.appleMusic }}",
          "https://djpardis.com"
        ]
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap"
    />

    <link rel="stylesheet" href="/css/tokens.css?v=v4" />
    <link rel="stylesheet" href="/css/base.css?v=v4" />
    <link rel="stylesheet" href="/css/components.css?v=v4" />
  </head>
  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    
    <main id="main" data-lightbox-group="page">
      {{ content | safe }}
    </main>
    <div class="player-bar" id="player-bar">
      <div class="player-bar__inner container">
        <span class="player-bar__label">Now playing</span>
        <div class="player-bar__embed">
          <iframe width="100%" height="20" scrolling="no" frameborder="no" allow="autoplay" src="https://w.soundcloud.com/player/?url=https%3A//soundcloud.com/djpardis&color=%23ff00aa&auto_play=false&hide_related=true&show_comments=false&show_user=false&show_reposts=true&show_teaser=false&visual=false"></iframe>
        </div>
      </div>
    </div>
    <script src="/js/lightbox.js?v=v2" defer></script>
    <script src="https://w.soundcloud.com/player/api.js" defer></script>
    <script>
    (function () {
      var scWidget = null;

      function initSC() {
        var iframe = document.querySelector('#player-bar iframe');
        if (!iframe || !window.SC) return;
        scWidget = SC.Widget(iframe);
      }

      document.addEventListener('DOMContentLoaded', function () {
        var check = setInterval(function () {
          if (window.SC && window.SC.Widget) { clearInterval(check); initSC(); }
        }, 200);
      });

      document.addEventListener('keydown', function (e) {
        if (e.code !== 'Space') return;
        var tag = e.target.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || e.target.isContentEditable) return;
        e.preventDefault();
        if (!scWidget) return;
        scWidget.toggle();
      });

      function swap(url, push) {
        fetch(url).then(function (r) { return r.text(); }).then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var newMain = doc.querySelector('#main');
          var oldMain = document.querySelector('#main');
          if (!newMain || !oldMain) { window.location = url; return; }
          oldMain.innerHTML = newMain.innerHTML;
          document.title = doc.title;
          if (push) history.pushState(null, '', url);
          window.scrollTo(0, 0);
          if (typeof window.initLightbox === 'function') window.initLightbox();
        }).catch(function () { window.location = url; });
      }

      document.addEventListener('click', function (e) {
        var a = e.target.closest('a');
        if (!a) return;
        var href = a.getAttribute('href');
        if (!href) return;
        if (a.target === '_blank' || a.hasAttribute('download')) return;
        if (href.indexOf('://') !== -1 && href.indexOf(location.origin) !== 0) return;
        if (href.indexOf('mailto:') === 0) return;
        e.preventDefault();
        swap(href, true);
      });
      window.addEventListener('popstate', function () { swap(location.href, false); });
    })();
    </script>
  </body>
</html>
