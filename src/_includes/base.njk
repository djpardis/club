<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>
      {%- if documentTitle -%}
        {{- documentTitle -}}
      {%- elif title -%}
        {{- title }} / {{ site.name -}}
      {%- else -%}
        {{- site.name }} – Pop house · West Coast · Booking worldwide -}}
      {%- endif -%}
    </title>
    <meta name="description" content="{{ description or site.description }}" />
    <meta name="author" content="DJ Pardis" />
    <meta name="keywords" content="DJ Pardis, djpardis, DJ Pardis booking, book DJ Pardis, pop house DJ, West Coast DJ, San Francisco DJ, corporate events DJ, conference DJ, gallery opening DJ, themed party DJ, booking worldwide" />
    {% if noIndex %}
      <meta name="robots" content="noindex, nofollow, max-image-preview:large" />
    {% else %}
      <meta name="robots" content="index, follow, max-image-preview:large" />
    {% endif %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    {% if documentTitle %}
      {% set ogTitle = documentTitle %}
    {% elif title %}
      {% set ogTitle = title + ' — ' + site.name %}
    {% else %}
      {% set ogTitle = site.name + ' — ' + site.tagline %}
    {% endif %}
    {% set ogImage = site.url + (ogImage or '/og.png') %}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="{{ ogTitle }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ ogImage }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DJ Pardis — pop house · West Coast · booking worldwide" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ ogTitle }}" />
    <meta name="twitter:description" content="{{ description or site.description }}" />
    <meta name="twitter:image" content="{{ ogImage }}" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/atom+xml" title="DJ Pardis — Mixtapes" href="/feed.xml" />
    <meta name="theme-color" content="#F5EDE0" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "DJ Pardis",
        "alternateName": ["djpardis", "Pardis"],
        "url": "{{ site.url }}",
        "jobTitle": "DJ",
        "description": "{{ site.description }}",
        "image": "{{ site.url }}{{ site.hero.photo }}",
        "sameAs": [
          "{{ site.socials.mixcloud }}",
          "{{ site.socials.soundcloud }}",
          "{{ site.socials.instagram }}",
          "https://djpardis.com"
        ]
      }
    </script>
    {% if page.url == "/" %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "{{ ogTitle }}",
        "url": "{{ site.url }}{{ page.url }}",
        "description": "{{ description or site.description }}",
        "primaryImageOfPage": {
          "@type": "ImageObject",
          "url": "{{ site.url }}{{ site.hero.photo }}",
          "caption": "{{ site.hero.alt }}"
        }
      }
    </script>
    {% endif %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "{{ site.name }}",
        "alternateName": ["djpardis", "djpardis.club"],
        "url": "{{ site.url }}",
        "description": "{{ site.description }}",
        "sameAs": [
          "https://djpardis.com",
          "{{ site.socials.mixcloud }}",
          "{{ site.socials.soundcloud }}",
          "{{ site.socials.instagram }}"
        ]
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "MusicGroup",
        "name": "DJ Pardis",
        "alternateName": ["djpardis"],
        "genre": ["Pop house", "Dance pop", "House"],
        "url": "{{ site.url }}",
        "image": "{{ site.url }}{{ site.hero.photo }}",
        "foundingLocation": {
          "@type": "Place",
          "name": "San Francisco, CA"
        },
        "member": {
          "@type": "Person",
          "name": "DJ Pardis"
        },
        "sameAs": [
          "{{ site.socials.mixcloud }}",
          "{{ site.socials.soundcloud }}",
          "{{ site.socials.instagram }}",
          "https://djpardis.com"
        ]
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    />

    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <script>
      // Capture the visible viewport height once so 100svh works correctly
      // in WKWebView in-app browsers (Instagram, TikTok, etc.) where it
      // otherwise overshoots. We deliberately do NOT listen to
      // visualViewport.resize: that fires constantly as the mobile URL bar
      // collapses/expands during scroll, which would re-size the fold and
      // shove the marquee around. We only re-measure when the viewport
      // width actually changes (orientation change or true window resize).
      (function () {
        var lastWidth = window.innerWidth;
        function setFoldHeight() {
          var h = (window.visualViewport ? window.visualViewport.height : window.innerHeight);
          document.documentElement.style.setProperty('--fold-h', h + 'px');
          lastWidth = window.innerWidth;
        }
        setFoldHeight();
        window.addEventListener('resize', function () {
          if (window.innerWidth !== lastWidth) setFoldHeight();
        });
        if (screen && screen.orientation) {
          screen.orientation.addEventListener('change', setFoldHeight);
        }
      })();
    </script>
  </head>
  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <main id="main">
      {{ content | safe }}
    </main>
    {% include "footer.njk" %}
  </body>
</html>
