---
layout: base.njk
documentTitle: "Listen — DJ Pardis"
description: Annual mixtapes and radio guest spots by DJ Pardis.
bodyClass: page-listen
---
<header class="page-header section section--page-top">
  <div class="container">
    {% set headEyebrow = "Listen" %}
    {% include "page-head.njk" %}
    <h1 class="page-title"><span class="hl">Mixtape</span> &amp; radio.</h1>
    <p class="page-subtitle">{{ mixtapes.length }} years · Guest radio spots</p>
  </div>
</header>

<section class="page-body section section--listen" aria-labelledby="mixtapes-label">
  <div class="container">
    <div class="mixtapes-head">
      <div class="mixtapes-head__title">
        <span class="page-kicker">// Mixtapes</span>
        <h2 id="mixtapes-label">Annual mixtapes</h2>
      </div>
      <span class="meta mixtapes-head__meta">
        One for every year, {{ mixtapes[mixtapes.length - 1].year }}–{{ mixtapes[0].year }}
        <span class="mixtapes-head__sep" aria-hidden="true">·</span>
        <a class="mixtapes-head__feed" href="/feed.xml">Subscribe (RSS)</a>
      </span>
    </div>
    <ul class="mixtapes-grid">
      {% for m in mixtapes | sortMixtapesDesc %}
        <li>
          <a class="mixtape-tile {% if loop.first %}mixtape-tile--latest{% endif %}" href="{{ m.url }}" rel="noopener">
            {% if loop.first %}<span class="mixtape-tile__badge">Latest</span>{% endif %}
            <span class="mixtape-tile__year">{{ m.year }}</span>
            <span class="mixtape-tile__title">{{ m.title }}</span>
            <span class="mixtape-tile__date">{{ m.date }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% if radio and radio.length %}
<section class="section section--sand" aria-labelledby="radio-label">
  <div class="container">
    <h2 class="sr-only" id="radio-label">Radio</h2>
    <span class="page-kicker">// Radio</span>
    <ul class="radio-list">
      {% for r in radio %}
        <li class="radio-item">
          <span class="radio-item__ep">Ep. {{ r.episode }} · {{ r.show }}</span>
          <a class="radio-item__title" href="{{ r.url }}" rel="noopener">{{ r.title }}</a>
          <div class="radio-item__meta">
            <span>with <a href="{{ r.withUrl }}" rel="noopener">{{ r.with }}</a></span>
            <span>·</span>
            <span><a href="{{ r.showUrl }}" rel="noopener">{{ r.show }}</a></span>
            <span>·</span>
            <span>{{ r.date }}</span>
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
