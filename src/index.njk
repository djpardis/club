---
layout: base.njk
documentTitle: "DJ Pardis"
description: DJ Pardis is a pop house DJ on the West Coast, booking worldwide for corporate events, conferences, gallery openings, and themed parties.
bodyClass: page-home
---

{# ── Hero: name left, subscribe + socials right ── #}
<section class="hero">
  <div class="container">
    <h1 class="hero__name">DJ <em>PARDIS</em></h1>
    <div class="hero__right">
      <div class="hero__top">
        <form class="hero__subscribe" data-action="{{ site.subscribeApiBase }}/api/subscribe" data-source="{{ site.subscribeSource }}" data-updates-form novalidate>
          <input type="text" name="website" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="email" name="email" required autocomplete="email" placeholder="Email" aria-label="Email address" />
          <button class="btn btn--sm" type="submit">Join</button>
        </form>
        <p class="hero__subscribe-status" data-updates-status role="status" aria-live="polite"></p>
        <ul class="hero__socials">
          <li><a href="{{ site.socials.instagram }}">IG</a></li>
          <li><a href="{{ site.socials.spotify }}">Spotify</a></li>
          <li><a href="{{ site.socials.appleMusic }}">Apple</a></li>
          <li><a href="{{ site.socials.soundcloud }}">SC</a></li>
          <li><a href="{{ site.socials.mixcloud }}">MC</a></li>
          <li><a href="/feed.xml">RSS</a></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<div class="container">

{# ── About: photo left, text right ── #}
<section class="cell" id="about">
  <span class="cell-label"><span class="hl">About</span></span>
  <div class="about-tile">
    <div class="about-tile__images">
      <figure class="about-tile__img">
        <img src="{{ site.hero.photo }}" alt="{{ site.hero.alt }}" width="{{ site.hero.width }}" height="{{ site.hero.height }}" loading="eager" decoding="async" />
        <figcaption>{{ site.hero.credit }}</figcaption>
      </figure>
      {% if gallery and gallery.length %}
      {% for g in gallery %}
      <figure class="about-tile__img">
        <img src="{{ g.src }}" alt="{{ g.alt }}" loading="lazy" decoding="async" />
        {% if g.caption %}<figcaption>{{ g.caption }}</figcaption>{% endif %}
      </figure>
      {% endfor %}
      {% endif %}
    </div>
    <div class="about-tile__text">
      <p>I started DJing in May 2017 and played <a href="https://vimeo.com/463652373">themed Tea Time tunes</a> at Twitter HQ, usually with <a href="https://soundcloud.com/juliengaillard">Julien Gaillard</a> on <a href="https://vimeo.com/463687716">guitar</a>.</p>
      <p style="margin-top: var(--sp-3);">In summer 2019 I was the tour DJ for <a href="https://soundcloud.com/ohsimsimah">Sim Simah</a> and <a href="https://music.apple.com/us/artist/aarxn-cxle/1453179768">Aarxn Cxle</a>. Photo by <a href="https://www.instagram.com/meria.agency/">Jesse Meria</a>, July 2019 at <a href="https://www.thenewparish.com/">The New Parish</a>.</p>
    </div>
  </div>
</section>

{# ── Listen: mixtapes + radio ── #}
<section class="cell" id="listen">
  <span class="cell-label"><span class="hl">Listen</span></span>
  <ul class="listen-list">
    {% for m in mixtapes | sortMixtapesDesc %}
      <li><a href="{{ m.url }}">
        <span class="listen-list__year">{{ m.year }}</span>
        <span class="listen-list__title">{{ m.title }}</span>
        <span class="listen-list__meta"><span class="hl-green">{{ m.date }}</span></span>
      </a></li>
    {% endfor %}
  </ul>
  {% if radio and radio.length %}
  <div class="listen-radio">
    <span class="cell-label"><span class="hl">Radio</span></span>
    <ul class="listen-list">
      {% for r in radio %}
        <li><a href="{{ r.url }}">
          <span class="listen-list__year">{{ r.title }}</span>
          <span class="listen-list__title">Ep. {{ r.episode }} · {{ r.show }} · {{ r.with }}</span>
          <span class="listen-list__meta"><span class="hl-green">{{ r.date }}</span></span>
        </a></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
</section>

</div>

{# ── Radio + Gallery: commented out until there's more to share
{% if (radio and radio.length) or (gallery and gallery.length) %}
<div class="container">
  <div class="split">
    <div class="split__left">
      {% if radio and radio.length %}
      <span class="cell-label">Radio</span>
      <ul class="radio-list">
        {% for r in radio %}
          <li class="radio-item">
            <a class="radio-item__title" href="{{ r.url }}">{{ r.title }}</a>
            <div class="radio-item__meta">Ep. {{ r.episode }} · <a href="{{ r.showUrl }}">{{ r.show }}</a> · <a href="{{ r.withUrl }}">{{ r.with }}</a> · {{ r.date }}</div>
          </li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    <div class="split__right">
      {% if gallery and gallery.length %}
      <span class="cell-label">Gallery</span>
      {% for g in gallery %}
        <figure class="gallery-thumb">
          <img src="{{ g.src }}" alt="{{ g.alt }}" loading="lazy" decoding="async" />
          {% if g.caption %}<figcaption>{{ g.caption }}</figcaption>{% endif %}
        </figure>
      {% endfor %}
      {% endif %}
    </div>
  </div>
</div>
{% endif %}
── #}

{# ── Book: tight 4-column form grid ── #}
<div class="container">
<section class="cell" id="book">
  <span class="cell-label"><span class="hl">Book</span></span>
  <form class="book-form" action="{{ site.forms.booking.action }}" method="POST" data-booking-form data-success-url="/book/thanks/">
    <input type="text" name="website" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="book-row">
      <input type="text" name="full_name" required autocomplete="name" placeholder="Name" aria-label="Name" />
      <input type="email" name="email" required autocomplete="email" placeholder="Email" aria-label="Email" />
      <input type="date" name="event_date" required data-event-date aria-label="Date" />
      <input type="text" name="event_location" required placeholder="Location" aria-label="Location" />
    </div>
    <div class="book-row">
      <input type="url" name="event_website" placeholder="URL (optional)" inputmode="url" aria-label="URL" />
      <input type="text" name="comments" placeholder="Details (optional)" aria-label="Details" />
      <button type="submit" class="btn btn--sm">Submit</button>
    </div>
    <p class="form-status" data-booking-status role="status" aria-live="polite"></p>
  </form>
</section>
</div>

{# ── Footer ── #}
<footer class="site-footer">
  <div class="container">
    <span>&copy; {% year %} DJ Pardis</span>
  </div>
</footer>

<script>
  (function () {
    var form = document.querySelector('[data-updates-form]');
    if (!form) return;
    var endpoint = form.getAttribute('data-action');
    if (!endpoint) return;
    var source = form.getAttribute('data-source') || '';
    var status = document.querySelector('[data-updates-status]');
    var button = form.querySelector('button[type="submit"]');
    var emailInput = form.querySelector('input[type="email"]');
    var hpInput = form.querySelector('input[name="website"]');
    var orig = button ? button.textContent : 'Join';

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = emailInput ? emailInput.value.trim() : '';
      if (!email) return;
      if (status) status.textContent = '';
      if (button) { button.disabled = true; button.textContent = '...'; }
      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ email: email, source: source, website: hpInput ? hpInput.value : '' }),
        credentials: 'omit', mode: 'cors'
      }).then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (b) { return { status: r.status, body: b || {} }; });
      }).then(function (r) {
        if (r.status === 200 && r.body.ok) { form.reset(); if (status) status.textContent = r.body.state === 'active' ? 'Already listed.' : 'Check email.'; }
        else if (r.status === 429) { if (status) status.textContent = 'Too many tries.'; }
        else { if (status) status.textContent = 'Error.'; }
        if (button) { button.disabled = false; button.textContent = orig; }
      }).catch(function () {
        if (status) status.textContent = 'Network error.';
        if (button) { button.disabled = false; button.textContent = orig; }
      });
    });
  })();

  (function () {
    var form = document.querySelector('[data-booking-form]');
    if (!form) return;
    var status = form.querySelector('[data-booking-status]');
    var button = form.querySelector('button[type="submit"]');
    var dateInput = form.querySelector('[data-event-date]');
    function today() { var n = new Date(); return n.getFullYear() + '-' + String(n.getMonth()+1).padStart(2,'0') + '-' + String(n.getDate()).padStart(2,'0'); }
    if (dateInput) dateInput.min = today();
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (dateInput && dateInput.value && dateInput.value < dateInput.min) { if (status) status.textContent = 'Future date.'; return; }
      if (dateInput) dateInput.setCustomValidity('');
      if (!form.reportValidity()) return;
      if (status) status.textContent = '';
      if (button) button.disabled = true;
      fetch(form.action, { method: 'POST', body: new FormData(form) })
        .then(function (r) { if (r.ok) { window.location.href = form.dataset.successUrl || '/book/thanks/'; return; } throw new Error('Failed'); })
        .catch(function (err) {
          if (status) status.textContent = err instanceof TypeError ? 'Unreachable.' : 'Error.';
          if (button) button.disabled = false;
        });
    });
  })();
</script>
